  "id": "glm-5-4",
  "metadata": {
    "description": "GLM-5.4 architecture with 78 distinct decoder layers and 106 layer applications: 26 layers before a 28-layer loop, 24 layers after the loop, and the same 28 middle layers used on both passes. The middle layer combines MLA with DeepSeek Sparse Attention, residual connections, and a 256-expert MoE layer with one shared expert and eight active experts per token.",
    "title": "GLM-5.4 (~750B)",
  },
  "schemaVersion": 1,
}
`;
